    </tr>

    <?php foreach ($items as $item): ?>
    <tr>
        <td><?= h($item["item_id"]) ?></td>
        <td><?= h($item["item_name"]) ?></td>
        <td><?= h($item["brand_name"]) ?></td>
        <td><?= h($item["category"]) ?></td>
        <td><?= h($item["unit_size"]) ?></td>
        <td><?= number_format((float) $item["price_rub"], 2) ?></td>
        <td><?= h($item["stock_quantity"]) ?></td>
        <td><?= h($item["shelf_life_days"]) ?></td>
        <td><?= h($item["created_at"]) ?></td>
    </tr>
    <?php endforeach; ?>

